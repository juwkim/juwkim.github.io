---
import { SITE } from '../site.config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const links = [
  { label: 'GitHub', href: SITE.links.github },
  { label: 'Instagram', href: SITE.links.instagram },
  { label: 'solved.ac', href: SITE.links.solvedac },
].filter((link) => link.href);

const email = SITE.links.email;
---

{(links.length > 0 || email) && (
  <div class:list={['profile-contacts', { compact }]}>
    {links.length > 0 && (
      <ul class="profile-links">
        {links.map(({ label, href }) => (
          <li>
            <a href={href}>
              <span>{label}</span>
              <span class="profile-link-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    {email && (
      <div class="profile-email">
        <span class="profile-email-label">Email</span>
        <span class="profile-email-address">{email}</span>
      </div>
    )}
  </div>
)}

<style>
  .profile-contacts {
    min-width: 0;
    max-width: 100%;
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
  }
  .profile-links li {
    display: flex;
  }
  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 32px;
    padding: 5px 12px 5px 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    border-color: color-mix(in srgb, var(--blue) 22%, transparent);
    background: var(--blue-soft);
    color: var(--blue);
    color: color-mix(in srgb, var(--blue) 82%, var(--fg));
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .profile-link-arrow {
    font-size: 0.9em;
    opacity: 0.75;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .profile-links a:hover {
    background: color-mix(in srgb, var(--blue) 15%, transparent);
    border-color: color-mix(in srgb, var(--blue) 45%, transparent);
  }
  .profile-links a:hover .profile-link-arrow,
  .profile-links a:focus-visible .profile-link-arrow {
    opacity: 1;
    transform: translateX(2px);
  }
  .profile-links a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
    border-radius: 999px;
    border-color: color-mix(in srgb, var(--blue) 45%, transparent);
  }
  /* 이메일: 링크가 아닌 평문 연락처 줄. 라벨은 선택에서 빠지고 주소만 그대로 드래그해 복사 */
  .profile-email {
    display: flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    max-width: 100%;
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .profile-email-label {
    flex: none;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--bg-subtle);
    color: var(--fg-2);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    user-select: none;
  }
  .profile-email-address {
    min-width: 0;
    color: var(--fg);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.005em;
    overflow-wrap: anywhere;
    user-select: text;
    cursor: text;
  }

  /* 홈 히어로용: 같은 모양, 조금 더 촘촘하게 */
  .compact .profile-links {
    gap: 6px 8px;
    margin-top: 18px;
    font-size: 13px;
  }
  .compact .profile-links a {
    min-height: 30px;
    padding: 4px 11px 4px 12px;
  }
  .compact .profile-email {
    gap: 8px;
    margin-top: 12px;
    padding-top: 10px;
  }
  .compact .profile-email-address {
    font-size: 14px;
  }
</style>
