---
import { SITE, CATEGORIES } from '../site.config';

const path = Astro.url.pathname;
const items = [
  { href: '/posts/', label: 'Posts', active: path.startsWith('/posts') || CATEGORIES.some((c) => path.startsWith(`/${c.slug}/`)) },
  { href: '/projects/', label: 'Projects', active: path.startsWith('/projects') },
  { href: '/about/', label: 'About', active: path.startsWith('/about') },
];
---

<header class="nav">
  <a class="logo" href="/">{SITE.title}</a>
  <nav aria-label="주 메뉴">
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: item.active }} aria-current={item.active ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="nav-actions">
    <a class="icon-btn" href="/search/" aria-label="검색">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
    </a>
    <button class="icon-btn" id="theme-toggle" type="button" aria-label="다크 모드 전환">
      <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 5;
    height: 52px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    /* 왼쪽 사이드바, 오른쪽 레일과 같은 화면 끝 간격(--edge)에 맞춰 정렬 */
    padding: 0 var(--edge);
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line);
  }
  .logo {
    justify-self: start;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
  }
  nav {
    justify-self: center;
    min-width: 0;
    max-width: 100%;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  ul::-webkit-scrollbar {
    display: none;
  }
  li a {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg-2);
    white-space: nowrap;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  li a:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }
  li a.active {
    background: var(--blue-soft);
    color: var(--blue);
    font-weight: 600;
  }
  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .icon-btn {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 0;
    background: none;
    padding: 0;
    color: var(--fg-2);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .icon-btn:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (max-width: 640px) {
    .nav {
      display: flex;
      padding: 0 16px;
      gap: 8px;
    }
    nav {
      margin-left: auto;
    }
    li a {
      padding: 5px 11px;
      font-size: 13px;
    }
  }
</style>
