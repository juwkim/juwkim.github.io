---
// 홈의 최근 글 카드
import { postUrl, shortDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, category, subcategory, description, date } = post.data;
---

<a class="card" href={postUrl(post)}>
  <span class="cat">{category} · {subcategory}</span>
  <span class="t">{title}</span>
  {description && <span class="desc">{description}</span>}
  <time datetime={date.toISOString()}>{shortDate(date)}</time>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px 18px;
    border-radius: 14px;
    background: var(--bg);
    border: 1px solid var(--line);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
    min-height: 164px;
  }
  .card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .card:hover .t {
    color: var(--blue);
  }
  .cat {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--blue);
  }
  .t {
    font-size: 17px;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.02em;
    word-break: keep-all;
    text-wrap: pretty;
    transition: color 0.2s var(--ease);
  }
  .desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  time {
    margin-top: auto;
    font-size: 12.5px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
</style>
