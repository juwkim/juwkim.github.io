---
// 카테고리 탐색: 넓은 화면에서는 왼쪽 사이드바, 좁은 화면에서는 위쪽 칩 줄로 보입니다.
import { categoryUrl, subUrl, countTree, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** 현재 보고 있는 카테고리/세부 카테고리 slug (없으면 전체) */
  current?: { cat?: string; sub?: string };
  /** sidebar: 넓은 화면용 왼쪽 목록, chips: 좁은 화면용 칩 줄 */
  mode: 'sidebar' | 'chips';
}

const { posts, current = {}, mode } = Astro.props;
const tree = countTree(posts);
const active = tree.find((t) => t.cat.slug === current.cat);
---

{mode === 'sidebar' && (
<nav class="sidebar" aria-label="카테고리">
  <a href="/posts/" class:list={['all', { on: !current.cat }]} aria-current={!current.cat ? 'page' : undefined}>
    <span>전체</span><span class="n">{posts.length}</span>
  </a>
  {
    tree.map(({ cat, count, subs }) => (
      <div class="group">
        <a
          href={categoryUrl(cat)}
          class:list={['cat', { on: current.cat === cat.slug && !current.sub }]}
          aria-current={current.cat === cat.slug && !current.sub ? 'page' : undefined}
        >
          <span>{cat.name}</span>
          <span class="n">{count}</span>
        </a>
        <ul>
          {subs
            .filter((s) => s.count > 0)
            .map(({ sub, count }) => {
              const on = current.cat === cat.slug && current.sub === sub.slug;
              return (
                <li>
                  <a href={subUrl(cat, sub)} class:list={{ on }} aria-current={on ? 'page' : undefined}>
                    <span>{sub.name}</span>
                    <span class="n">{count}</span>
                  </a>
                </li>
              );
            })}
        </ul>
      </div>
    ))
  }
</nav>
)}

{mode === 'chips' && (
<nav class="chips-nav" aria-label="카테고리">
  <div class="row">
    <a href="/posts/" class:list={['chip', { on: !current.cat }]}>전체 <span>{posts.length}</span></a>
    {
      tree.map(({ cat, count }) => (
        <a href={categoryUrl(cat)} class:list={['chip', { on: current.cat === cat.slug }]}>
          {cat.name} <span>{count}</span>
        </a>
      ))
    }
  </div>
  {
    active && (
      <div class="row sub">
        <a href={categoryUrl(active.cat)} class:list={['chip', 'small', { on: !current.sub }]}>
          전체
        </a>
        {active.subs
          .filter((s) => s.count > 0)
          .map(({ sub, count }) => (
            <a href={subUrl(active.cat, sub)} class:list={['chip', 'small', { on: current.sub === sub.slug }]}>
              {sub.name} <span>{count}</span>
            </a>
          ))}
      </div>
    )
  }
</nav>
)}

<style>
  /* ---------- 사이드바 ---------- */
  .sidebar {
    display: none;
  }
  @media (min-width: 1080px) {
    .sidebar {
      display: block;
      position: sticky;
      top: 84px;
      align-self: start;
      max-height: calc(100dvh - 104px);
      overflow-y: auto;
      padding: 0 4px 24px 0;
      scrollbar-width: thin;
    }
    .chips-nav {
      display: none;
    }
  }
  .sidebar a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--fg-2);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .sidebar a:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }
  .sidebar a.on {
    background: var(--blue-soft);
    color: var(--blue);
    font-weight: 500;
  }
  .sidebar .n {
    font-size: 12px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .sidebar a.on .n {
    color: var(--blue);
    opacity: 0.7;
  }
  .sidebar .all,
  .sidebar .cat {
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.015em;
  }
  .group {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .group ul {
    list-style: none;
    margin: 2px 0 0;
    padding: 0 0 0 10px;
  }

  /* ---------- 칩 (좁은 화면) ---------- */
  .chips-nav {
    margin: 0 0 8px;
  }
  .row {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
    margin: 0 -24px;
    padding-inline: 24px;
  }
  .row::-webkit-scrollbar {
    display: none;
  }
  .row.sub {
    margin-top: 10px;
  }
  .chip {
    flex: none;
    font-size: 13px;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--fg-2);
    white-space: nowrap;
    transition: all 0.2s var(--ease);
  }
  .chip span {
    color: var(--fg-3);
    margin-left: 2px;
    font-variant-numeric: tabular-nums;
  }
  .chip:hover {
    border-color: var(--fg-3);
    color: var(--fg);
  }
  .chip.on {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .chip.on span {
    color: inherit;
    opacity: 0.6;
  }
  .chip.small {
    font-size: 12.5px;
    padding: 5px 11px;
    border-color: var(--line);
  }
  .chip.small.on {
    background: var(--blue-soft);
    border-color: transparent;
    color: var(--blue);
  }
</style>
