---
// 카테고리 탐색: 넓은 화면에서는 왼쪽 사이드바(맨 위 미니 프로필 포함), 좁은 화면에서는 위쪽 칩 줄로 보입니다.
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { SITE } from '../site.config';
import { categoryUrl, subUrl, countTree, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** 현재 보고 있는 카테고리/세부 카테고리 slug (없으면 전체) */
  current?: { cat?: string; sub?: string };
  /** sidebar: 넓은 화면용 왼쪽 목록, chips: 좁은 화면용 칩 줄 */
  mode: 'sidebar' | 'chips';
  /** current.cat이 없을 때 '전체'를 현재 페이지로 강조할지 (홈에서는 false) */
  highlightAll?: boolean;
}

const { posts, current = {}, mode, highlightAll = true } = Astro.props;
const tree = countTree(posts);
const active = tree.find((t) => t.cat.slug === current.cat);
const allOn = highlightAll && !current.cat;
---

{mode === 'sidebar' && (
<nav class="sidebar" aria-label="카테고리">
  <div class="sidebar-profile">
    <div class="profile-head">
      <a class="profile-avatar" href="/about/" tabindex="-1" aria-hidden="true">
        <Image src={avatar} alt="" width={104} height={104} quality={85} loading="eager" />
      </a>
      <div class="profile-id">
        <a class="profile-name" href="/about/">{SITE.author}</a>
        <span class="profile-handle">@{SITE.title}</span>
      </div>
    </div>
    <p class="profile-bio">배우고 만들고 기록합니다.</p>
    <div class="sidebar-social">
      <a href={SITE.links.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      <a href={SITE.links.solvedac} target="_blank" rel="noopener">solved.ac <span aria-hidden="true">↗</span></a>
      <a href="/about/">About <span aria-hidden="true">›</span></a>
    </div>
  </div>
  <div class="sidebar-cats">
  <a href="/posts/" class:list={['all', { on: allOn }]} aria-current={allOn ? 'page' : undefined}>
    <span>전체</span><span class="n">{posts.length}</span>
  </a>
  {
    tree.map(({ cat, count, subs }) => (
      <div class="group">
        <a
          href={categoryUrl(cat)}
          class:list={['cat', { on: current.cat === cat.slug && !current.sub }]}
          aria-current={current.cat === cat.slug && !current.sub ? 'page' : undefined}
        >
          <span>{cat.name}</span>
          <span class="n">{count}</span>
        </a>
        <ul>
          {subs
            .filter((s) => s.count > 0)
            .map(({ sub, count }) => {
              const on = current.cat === cat.slug && current.sub === sub.slug;
              return (
                <li>
                  <a href={subUrl(cat, sub)} class:list={{ on }} aria-current={on ? 'page' : undefined}>
                    <span>{sub.name}</span>
                    <span class="n">{count}</span>
                  </a>
                </li>
              );
            })}
        </ul>
      </div>
    ))
  }
  </div>
</nav>
)}

{mode === 'chips' && (
<nav class="chips-nav" aria-label="카테고리">
  <div class="row">
    <a href="/posts/" class:list={['chip', { on: allOn }]} aria-current={allOn ? 'page' : undefined}>
      전체 <span>{posts.length}</span>
    </a>
    {
      tree.map(({ cat, count }) => (
        <a href={categoryUrl(cat)} class:list={['chip', { on: current.cat === cat.slug }]}>
          {cat.name} <span>{count}</span>
        </a>
      ))
    }
  </div>
  {
    active && (
      <div class="row sub">
        <a href={categoryUrl(active.cat)} class:list={['chip', 'small', { on: !current.sub }]}>
          전체
        </a>
        {active.subs
          .filter((s) => s.count > 0)
          .map(({ sub, count }) => (
            <a href={subUrl(active.cat, sub)} class:list={['chip', 'small', { on: current.sub === sub.slug }]}>
              {sub.name} <span>{count}</span>
            </a>
          ))}
      </div>
    )
  }
</nav>
)}

<style>
  /* ---------- 사이드바 ---------- */
  .sidebar {
    display: none;
  }
  @media (min-width: 1080px) {
    .sidebar {
      display: block;
      position: fixed;
      top: 52px;
      bottom: 0;
      left: max(32px, calc((100% - var(--page)) / 2 + 32px));
      width: var(--sidebar);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 28px 10px 40px 0;
      /* 스크롤바는 숨김 (마우스를 올리면 사이드바만 독립 스크롤) */
      scrollbar-width: none;
    }
    .chips-nav {
      display: none;
    }
  }
  @media print {
    .sidebar,
    .chips-nav {
      display: none;
    }
  }
  .sidebar::-webkit-scrollbar {
    display: none;
  }

  /* ---------- 미니 프로필 (사이드바 맨 위) ---------- */
  .sidebar-profile {
    padding: 0 10px 18px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .profile-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .profile-avatar {
    flex: none;
    display: block;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line);
    transition: opacity 0.2s var(--ease);
  }
  .profile-avatar:hover {
    opacity: 0.85;
  }
  .profile-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* About 페이지와 같은 방식으로 얼굴이 가운데 오도록 살짝 확대 */
    object-position: 50% 30%;
    transform: scale(1.18);
    transform-origin: 50% 40%;
  }
  .profile-id {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .profile-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    transition: color 0.2s var(--ease);
  }
  .profile-name:hover {
    color: var(--blue);
  }
  .profile-handle {
    font-size: 12.5px;
    color: var(--fg-3);
  }
  .profile-bio {
    margin: 12px 0 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--fg-2);
    word-break: keep-all;
  }
  .sidebar-social {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 10px;
    font-size: 12px;
  }
  .sidebar-social a {
    color: var(--fg-3);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .sidebar-social a:hover {
    color: var(--fg);
  }

  /* ---------- 카테고리 목록 ---------- */
  .sidebar-cats a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--fg-2);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .sidebar-cats a:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }
  .sidebar-cats a.on {
    background: var(--blue-soft);
    color: var(--blue);
    font-weight: 500;
  }
  .sidebar-cats .n {
    font-size: 12px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .sidebar-cats a.on .n {
    color: var(--blue);
    opacity: 0.7;
  }
  .sidebar-cats .all,
  .sidebar-cats .cat {
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.015em;
  }
  .group {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .group ul {
    list-style: none;
    margin: 2px 0 0;
    padding: 0 0 0 10px;
  }

  /* ---------- 칩 (좁은 화면) ---------- */
  .chips-nav {
    margin: 0 0 8px;
  }
  .row {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
    margin: 0 -24px;
    padding-inline: 24px;
  }
  .row::-webkit-scrollbar {
    display: none;
  }
  .row.sub {
    margin-top: 10px;
  }
  .chip {
    flex: none;
    font-size: 13px;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--fg-2);
    white-space: nowrap;
    transition: all 0.2s var(--ease);
  }
  .chip span {
    color: var(--fg-3);
    margin-left: 2px;
    font-variant-numeric: tabular-nums;
  }
  .chip:hover {
    border-color: var(--fg-3);
    color: var(--fg);
  }
  .chip.on {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .chip.on span {
    color: inherit;
    opacity: 0.6;
  }
  .chip.small {
    font-size: 12.5px;
    padding: 5px 11px;
    border-color: var(--line);
  }
  .chip.small.on {
    background: var(--blue-soft);
    border-color: transparent;
    color: var(--blue);
  }
</style>
