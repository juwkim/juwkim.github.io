---
import { SITE } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="page">
  <div class="inner">
    <span>© {year} {SITE.authorEn}</span>
    <a href={SITE.links.github} rel="me">GitHub</a>
  </div>
</footer>

<style>
  footer {
    margin-top: 72px;
  }
  .inner {
    border-top: 1px solid var(--line);
    padding: 28px 0 36px;
    font-size: 12.5px;
    color: var(--fg-3);
    display: flex;
    justify-content: space-between;
  }
  a:hover {
    color: var(--fg);
  }
  /* 사이드바가 있는 페이지: 화면 전체 폭을 쓰고, 왼쪽 고정 사이드바(사이드바 + 56px)를 피해 정렬 */
  @media (min-width: 1080px) {
    :global(body:has(.sidebar)) footer.page {
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      padding: 0 var(--edge);
    }
    :global(body:has(.sidebar)) footer .inner {
      margin-left: calc(var(--sidebar) + 56px);
    }
  }
  /* 홈: 오른쪽 화면 끝에 What I Made 레일도 고정되므로 오른쪽도 비워 둠 */
  @media (min-width: 1360px) {
    :global(body:has(.made-rail)) footer .inner {
      margin-right: calc(var(--rail) + 56px);
    }
  }
</style>
