---
import { SITE } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="page">
  <div class="inner">
    <span>© {year} {SITE.authorEn}</span>
    <a href={SITE.links.github} rel="me">GitHub</a>
  </div>
</footer>

<style>
  footer {
    margin-top: 72px;
  }
  .inner {
    border-top: 1px solid var(--line);
    padding: 28px 0 36px;
    font-size: 12.5px;
    color: var(--fg-3);
    display: flex;
    justify-content: space-between;
  }
  a:hover {
    color: var(--fg);
  }
</style>
