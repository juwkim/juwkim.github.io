---
import Base from '../layouts/Base.astro';
import { profile, aspirations, dreams, now, steps } from '../data/about';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import ProfileContacts from '../components/ProfileContacts.astro';
---

<Base title="About" description={profile.tagline.join(" ")}>
  <div class="page">
    <header class="profile">
      <div class="avatar">
        <Image src={avatar} alt={`${profile.name} 프로필 사진`} width={192} height={192} quality={85} loading="eager" />
      </div>
      <div class="profile-body">
        <h1>{profile.name}</h1>
        <p>{profile.tagline.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
        <ProfileContacts />
      </div>
    </header>

    <section class="aspire" aria-labelledby="aspire">
      <div class="section-head">
        <h2 id="aspire">평생의 나침반</h2>
        <span class="note">20~30년, 그리고 평생</span>
      </div>
      <div class="aspire-grid">
        {
          aspirations.map((a) => (
            <div class="aspire-item">
              <span class="label">{a.label}</span>
              <p class="atitle">{a.title}</p>
              <p class="abody">{a.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="cols">
    <section class="a-dreams" aria-labelledby="dreams">
      <div class="section-head">
        <h2 id="dreams">가꿔 갈 꿈</h2>
        <span class="note">앞으로 5~10년</span>
      </div>
      <ol class="dreams">
        {
          dreams.map((d) => (
            <li class:list={{ done: d.done }}>
              <span class="ring" aria-label={d.done ? '이룸' : '진행 중'} />
              <div>
                <div class="dt">{d.title}</div>
                <div class="dd">{d.why}</div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="a-now" aria-labelledby="now">
      <div class="section-head">
        <h2 id="now">요즘의 나</h2>
        <span class="note">지금부터 1년 안 · {now.updated} 업데이트</span>
      </div>
      <dl class="now">
        {
          now.items.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="a-steps" aria-labelledby="steps">
      <div class="section-head">
        <h2 id="steps">지나온 발걸음</h2>
        <span class="note">넘어지고, 다시 일어선 기록</span>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <time>{s.date}</time>
              <div>
                <div class="w">{s.title}</div>
                <div class="x">
                  {s.note}
                  {s.link && (s.link.startsWith('http') ? <a href={s.link} target="_blank" rel="noopener">{` ${s.linkLabel ?? '후기'} ↗`}</a> : <a href={s.link}>{` ${s.linkLabel ?? '후기'} ›`}</a>)}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
    </div>
  </div>
</Base>

<style>
  .profile-body {
    min-width: 0;
  }
  /* About 섹션 제목: 시간의 층위가 한눈에 보이도록 조금 더 또렷하게 */
  .page .section-head {
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .page .section-head h2 {
    font-size: clamp(20px, 2.4vw, 24px);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .page .section-head .note {
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }
  /* 평생의 나침반: 5~10년의 꿈 위에 놓인, 평생 품을 일과 삶의 방향 */
  .aspire {
    margin-bottom: 56px;
  }
  .aspire-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 16px;
  }
  @media (min-width: 760px) {
    .aspire-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
  .aspire-item {
    position: relative;
    padding: 26px 28px 24px;
    border-radius: 20px;
    background: linear-gradient(180deg, var(--blue-soft), transparent 140%);
    border: 1px solid var(--line);
  }
  .label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 34px;
    padding: 4px 14px;
    margin-bottom: 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    border-color: color-mix(in srgb, var(--blue) 26%, transparent);
    background: var(--bg);
    color: var(--blue);
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }
  .atitle {
    margin: 0 0 10px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.4;
    word-break: keep-all;
  }
  .abody {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--fg-2);
    word-break: keep-all;
  }
  /* 읽는 순서 = 시간 순서: 평생 → 5~10년 → 지금(1년 안) → 지나온 길.
     넓은 화면: 위(가꿔 갈 꿈, 2열) → 아래 왼쪽(요즘의 나, 스크롤해도 따라옴) | 오른쪽(지나온 발걸음) */
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 960px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-areas: "dreams dreams" "now steps";
      column-gap: 72px;
      align-items: start;
    }
    .dreams {
      grid-template-columns: 1fr 1fr;
      column-gap: 72px;
    }
    .dreams li:nth-child(odd):nth-last-child(2) {
      border-bottom: 0;
    }
    .a-dreams {
      grid-area: dreams;
    }
    .a-steps {
      grid-area: steps;
    }
    .a-now {
      grid-area: now;
      position: sticky;
      top: 84px;
    }
  }
  .profile {
    display: flex;
    gap: 24px;
    align-items: center;
    padding: 72px 0 48px;
  }
  /* 프로필 사진: 원형 + 얇은 테두리 + 은은한 그림자, 얼굴이 가운데 오도록 살짝 확대 */
  .avatar {
    position: relative;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    flex: none;
    overflow: hidden;
    background: var(--bg-subtle);
    box-shadow:
      0 0 0 1px var(--line),
      0 2px 6px rgba(0, 0, 0, 0.06),
      0 12px 28px -8px rgba(0, 113, 227, 0.28);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .avatar:hover {
    transform: scale(1.04);
    box-shadow:
      0 0 0 1px var(--line),
      0 4px 10px rgba(0, 0, 0, 0.08),
      0 18px 36px -10px rgba(0, 113, 227, 0.4);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.18);
    transform-origin: 50% 40%;
  }
  .profile h1 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 6px;
  }
  .profile p {
    margin: 0;
    color: var(--fg-2);
    font-size: 16px;
    line-height: 1.6;
    word-break: keep-all;
  }

  /* 가꿔 갈 꿈 (5~10년) */
  .dreams {
    display: grid;
    list-style: none;
    margin: 8px 0 56px;
    padding: 0;
  }
  .dreams li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .dreams li:last-child {
    border-bottom: 0;
  }
  .ring {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    margin-top: 2px;
    position: relative;
  }
  .ring::after {
    content: '';
    position: absolute;
    inset: 3.5px;
    border-radius: 50%;
    background: var(--blue-soft);
  }
  .done .ring {
    background: var(--blue);
  }
  .done .ring::after {
    background: none;
    inset: 0;
    border: solid #fff;
    border-width: 0 1.5px 1.5px 0;
    width: 4px;
    height: 8px;
    border-radius: 0;
    left: 5.5px;
    top: 2.5px;
    transform: rotate(45deg);
  }
  .dt {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.5;
    word-break: keep-all;
  }
  .dd {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
    margin-top: 4px;
    word-break: keep-all;
  }

  /* 요즘의 나 */
  .now {
    margin: 8px 0 56px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .now div {
    background: var(--bg-subtle);
    border-radius: 14px;
    padding: 16px 18px;
  }
  .now dt {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--blue);
    margin-bottom: 6px;
  }
  .now dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    word-break: keep-all;
    letter-spacing: -0.015em;
  }

  /* 지나온 발걸음 */
  .steps {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    position: relative;
  }
  .steps::before {
    content: '';
    position: absolute;
    left: 89.5px;
    top: 26px;
    bottom: 26px;
    width: 1px;
    background: var(--line-strong);
  }
  .steps li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 20px;
    padding: 14px 0;
    position: relative;
  }
  .steps li::before {
    content: '';
    position: absolute;
    left: 86px;
    top: 22px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 1.5px var(--fg-3);
  }
  .steps li:first-child::before {
    background: var(--blue);
    box-shadow: 0 0 0 1.5px var(--blue), 0 0 0 5px var(--blue-soft);
  }
  .steps time {
    font-size: 13.5px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .steps li > div {
    padding-left: 22px;
  }
  .w {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .x {
    font-size: 14px;
    color: var(--fg-2);
    margin-top: 4px;
    line-height: 1.55;
    word-break: keep-all;
  }
  .x a {
    color: var(--blue);
  }

  @media (max-width: 640px) {
    .profile {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .now {
      grid-template-columns: 1fr;
    }
    .aspire-item {
      padding: 22px 22px 20px;
    }
    .atitle {
      font-size: 19px;
    }
    .steps::before {
      left: 69.5px;
    }
    .steps li {
      grid-template-columns: 60px 1fr;
    }
    .steps li::before {
      left: 66px;
    }
  }
</style>
