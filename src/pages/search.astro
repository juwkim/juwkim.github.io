---
import Base from '../layouts/Base.astro';
---

<Base title="검색">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div class="wrap">
    <header class="head">
      <h1>검색</h1>
    </header>
    <div id="search"></div>
    <noscript><p>검색은 JavaScript가 필요합니다.</p></noscript>
  </div>
</Base>

<!-- Pagefind: 빌드할 때 만든 색인으로 서버 없이 검색 (npm run build 후에만 동작) -->
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) {
      document.getElementById('search').innerHTML =
        '<p class="dev-note">검색 색인은 빌드 후에 만들어집니다. (npm run build → npm run preview)</p>';
      return;
    }
    new window.PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      autofocus: true,
      translations: {
        placeholder: '글 제목, 내용으로 검색',
        zero_results: '[SEARCH_TERM]에 대한 결과가 없습니다',
        many_results: '[COUNT]개의 결과',
        one_result: '1개의 결과',
        load_more: '더 보기',
        clear_search: '지우기',
      },
    });
  });
</script>

<style>
  .head {
    padding: 72px 0 24px;
  }
  h1 {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
  }
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--blue);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--line-strong);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: var(--font);
  }
  #search :global(mark) {
    background: var(--blue-soft);
    color: inherit;
    border-radius: 3px;
  }
  #search :global(.dev-note) {
    color: var(--fg-3);
  }
</style>
