---
// 홈: 글 목록 페이지(PostIndex)와 같은 2단 구성. 왼쪽 카테고리, 오른쪽 짧은 소개와 최근 글.
import Base from '../layouts/Base.astro';
import CategoryNav from '../components/CategoryNav.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site.config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const recent = posts.slice(0, 6);
---

<Base>
  <div class="layout">
    <aside>
      <CategoryNav mode="sidebar" posts={posts} highlightAll={false} />
    </aside>
    <div class="main">
      <header class="intro">
        <h1>{SITE.hero.title.join(' ')}</h1>
        <p>{SITE.hero.body}</p>
        <div class="meta">
          <span>총 {posts.length}편의 기록</span>
          <span class="dot" aria-hidden="true">·</span>
          <a href="/about/">About ›</a>
        </div>
      </header>

      <CategoryNav mode="chips" posts={posts} highlightAll={false} />

      <section class="recent" aria-labelledby="recent">
        <div class="section-head">
          <h2 id="recent">최근 글</h2>
          <a href="/posts/">전체 {posts.length}개 보기 ›</a>
        </div>
        <div class="grid">
          {recent.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .layout {
    max-width: var(--page);
    margin: 0 auto;
    padding: 0 32px;
  }
  @media (max-width: 640px) {
    .layout {
      padding: 0 24px;
    }
  }
  aside {
    display: none;
  }

  /* ---------- 소개 ---------- */
  .intro {
    padding: 52px 0 22px;
    max-width: 620px;
  }
  h1 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.35;
    word-break: keep-all;
    margin: 0 0 10px;
  }
  .intro p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg-2);
    margin: 0;
    word-break: keep-all;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: 14px;
    font-size: 13.5px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .dot {
    opacity: 0.7;
  }
  .meta a {
    color: var(--blue);
  }
  .meta a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- 최근 글 ---------- */
  .recent {
    margin: 24px 0 72px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  @media (min-width: 1080px) {
    .layout {
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 64px;
      padding-top: 72px;
    }
    aside {
      display: block;
    }
    .intro {
      padding: 0 0 28px;
    }
    h1 {
      font-size: 26px;
    }
    .recent {
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .grid :global(.card) {
      min-height: 0;
    }
  }
</style>
