---
// 홈
// 좁은 화면(1080px 미만): 소개, 카테고리 칩, 최근 글, What I Made를 한 줄로
// 1080px 이상: 왼쪽 프로필·카테고리 | 오른쪽 소개, 최근 글, 그 아래 What I Made
// 1360px 이상: 왼쪽 프로필·카테고리 | 가운데 소개와 최근 글 | 오른쪽 What I Made 레일
import Base from '../layouts/Base.astro';
import CategoryNav from '../components/CategoryNav.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site.config';
import { getPosts } from '../lib/posts';
import { PROJECTS } from '../data/projects';

const posts = await getPosts();
const recent = posts.slice(0, 6);
---

<Base>
  <div class="layout">
    <aside class="side">
      <CategoryNav mode="sidebar" posts={posts} highlightAll={false} />
    </aside>
    <div class="main">
      <header class="intro">
        <h1>{SITE.hero.body}</h1>
        <div class="meta">
          <span>총 {posts.length}편의 기록</span>
        </div>
      </header>

      <CategoryNav mode="chips" posts={posts} highlightAll={false} />

      <section class="recent" aria-labelledby="recent">
        <div class="section-head">
          <h2 id="recent">최근 글</h2>
          <a href="/posts/">전체 보기 ›</a>
        </div>
        <div class="grid">
          {recent.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    </div>

    <aside class="made-rail" aria-labelledby="made-heading">
      <div class="section-head">
        <h2 id="made-heading">What I Made</h2>
        <a href="/projects/">전체 보기 ›</a>
      </div>
      <p class="made-caption">직접 만들고 실험한 작품과 빌더 기록입니다.</p>
      <ul class="made-list">
        {
          PROJECTS.map((p) => (
            <li>
              <article class="made-card">
                <div class="made-top">
                  <span class="made-cat">{p.category}</span>
                  <span class="pill">{p.statusLabel}</span>
                </div>
                <h3>
                  <a href={`/projects/#${p.slug}`}>{p.title}</a>
                </h3>
                <p class="made-summary">{p.summary}</p>
                <div class="made-links">
                  {p.links.map((l) =>
                    l.external ? (
                      <a href={l.href} target="_blank" rel="noopener">
                        {l.label} <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <a href={l.href}>
                        {l.label} <span aria-hidden="true">›</span>
                      </a>
                    ),
                  )}
                </div>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="made-note">직접 체험할 수 있는 웹 데모도 순차적으로 채워 갈 예정입니다.</p>
    </aside>
  </div>
</Base>

<style>
  .layout {
    max-width: none;
    margin: 0;
    padding: 0 var(--edge);
  }
  @media (max-width: 640px) {
    .layout {
      padding: 0 24px;
    }
  }
  .side {
    display: none;
  }
  .main {
    min-width: 0;
  }

  /* ---------- 소개 ---------- */
  .intro {
    padding: 48px 0 20px;
    max-width: 640px;
  }
  h1 {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.5;
    word-break: keep-all;
    margin: 0 0 8px;
  }
  .meta {
    font-size: 13.5px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 최근 글 ---------- */
  .recent {
    margin: 24px 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  /* ---------- What I Made ---------- */
  .made-rail {
    min-width: 0;
    margin-top: 56px;
  }
  .made-caption {
    margin: 12px 0 14px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--fg-3);
    word-break: keep-all;
  }
  .made-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .made-list li {
    display: flex;
    min-width: 0;
  }
  .made-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .made-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .made-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .made-cat {
    font-size: 12px;
    font-weight: 500;
    color: var(--blue);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pill {
    flex: none;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.4;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--fg-2);
  }
  .made-card h3 {
    margin: 2px 0 0;
    font-size: 15.5px;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .made-card h3 a {
    transition: color 0.2s var(--ease);
  }
  .made-card h3 a:hover {
    color: var(--blue);
  }
  .made-summary {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--fg-3);
    word-break: keep-all;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .made-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: auto;
    padding-top: 6px;
    font-size: 12.5px;
  }
  .made-links a {
    color: var(--blue);
    white-space: nowrap;
  }
  .made-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .made-note {
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--fg-3);
    word-break: keep-all;
  }

  /* ---------- 1080px 이상: 왼쪽 사이드바 | 오른쪽 열 (What I Made는 오른쪽 열 아래) ---------- */
  @media (min-width: 1080px) {
    .layout {
      display: grid;
      grid-template-columns: var(--sidebar) minmax(0, 1fr);
      column-gap: 48px;
      padding-top: 56px;
    }
    .side {
      display: block;
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .main {
      grid-column: 2;
      grid-row: 1;
    }
    .made-rail {
      grid-column: 2;
      grid-row: 2;
    }
    .intro {
      padding: 0 0 24px;
    }
    h1 {
      font-size: 20px;
    }
    .recent {
      margin-top: 0;
    }
  }

  /* ---------- 1360px 이상: 오른쪽 화면 끝에 고정된 What I Made 레일 ----------
     레일은 position: fixed라 그리드 흐름에서 빠지지만, 세 번째 열(--rail)이 같은 자리를 비워 두어
     가운데 .main과 겹치지 않음. 레일은 사이드바처럼 독립 스크롤 */
  @media (min-width: 1360px) {
    .layout {
      grid-template-columns: var(--sidebar) minmax(0, 1fr) var(--rail);
      column-gap: 56px;
    }
    .side {
      grid-row: 1;
    }
    .main {
      max-width: 1040px;
      width: 100%;
      margin: 0 auto;
    }
    .made-rail {
      position: fixed;
      top: 52px;
      bottom: 0;
      right: var(--edge);
      width: var(--rail);
      margin-top: 0;
      padding: 28px 4px 40px 12px;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .made-rail::-webkit-scrollbar {
      display: none;
    }
    .made-list {
      grid-template-columns: 1fr;
    }
  }
  /* 인쇄할 때는 레일을 고정하지 않고 본문 아래로 자연스럽게 흐르게 */
  @media print {
    .made-rail {
      position: static;
      width: auto;
      padding: 0;
      overflow: visible;
    }
  }

  @media (max-width: 640px) {
    .grid,
    .made-list {
      grid-template-columns: 1fr;
    }
    .grid :global(.card) {
      min-height: 0;
    }
  }
</style>
