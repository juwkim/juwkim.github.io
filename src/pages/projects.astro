---
// Projects: 직접 만든 도구와 프로젝트 모음. 내용은 src/data/projects.ts에서 관리합니다.
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../data/projects';
---

<Base title="Projects" description="직접 만든 도구와 프로젝트, 빌더로서 쌓아 온 결과물을 모아 둔 공간입니다.">
  <div class="page">
    <header class="head">
      <p class="eyebrow">Projects</p>
      <h1>What I Made</h1>
      <p class="sub">
        직접 만든 도구와 프로젝트를 모아 두는 곳입니다. 만든 이유와 과정은 글로 남기고, 웹에서 바로 써 볼 수 있는 데모도 하나씩
        이곳에 올릴 예정입니다.
      </p>
    </header>

    <div class="grid">
      {
        PROJECTS.map((p) => (
          <article class="project" id={p.slug} aria-labelledby={`${p.slug}-title`}>
            <div class="top">
              <span class="cat">
                {p.category} <span aria-hidden="true">·</span> {p.period}
              </span>
              <span class="pill">{p.statusLabel}</span>
            </div>
            <h2 id={`${p.slug}-title`}>{p.title}</h2>
            <p class="desc">{p.description}</p>
            <ul class="highlights" aria-label="주요 내용">
              {p.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <ul class="tags" aria-label="태그">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <div class="links">
              {p.links.map((l) =>
                l.external ? (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <a href={l.href}>
                    {l.label} <span aria-hidden="true">›</span>
                  </a>
                ),
              )}
            </div>
          </article>
        ))
      }
    </div>

    <aside class="demo-note" aria-labelledby="demo-note-title">
      <p class="demo-label" id="demo-note-title">Interactive Demos · 준비 중</p>
      <p>
        Drive2Model Cross-Labeler를 시작으로, 브라우저에서 바로 체험할 수 있는 웹 데모를 준비되는 대로 이 페이지 아래에 하나씩 올려 둘
        예정입니다.
      </p>
    </aside>
  </div>
</Base>

<style>
  /* ---------- 머리말 ---------- */
  .head {
    padding: 72px 0 36px;
    max-width: 680px;
  }
  .eyebrow {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--blue);
  }
  h1 {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin: 0 0 12px;
  }
  .sub {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--fg-2);
    word-break: keep-all;
  }

  /* ---------- 프로젝트 카드 ---------- */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .project:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  /* 홈에서 카드 제목을 눌러 들어오면 해당 카드를 살짝 강조 */
  .project:target {
    border-color: var(--blue);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .cat {
    font-size: 13px;
    font-weight: 500;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  .pill {
    flex: none;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--fg-2);
  }
  h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.025em;
    word-break: keep-all;
  }
  .desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--fg-2);
    word-break: keep-all;
  }
  .highlights {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .highlights li {
    position: relative;
    padding-left: 14px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--fg-2);
    word-break: keep-all;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--fg-3);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
  }
  .tags li {
    font-size: 12.5px;
    color: var(--fg-2);
    background: var(--bg-subtle);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .links a {
    color: var(--blue);
    font-weight: 500;
    white-space: nowrap;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- 데모 안내 ---------- */
  .demo-note {
    margin-top: 28px;
    padding: 20px 24px;
    border-radius: 14px;
    background: var(--bg-subtle);
  }
  .demo-label {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-3);
  }
  .demo-note p:last-child {
    margin-bottom: 0;
  }
  .demo-note p:not(.demo-label) {
    margin-top: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--fg-2);
    word-break: keep-all;
  }

  @media (max-width: 640px) {
    .head {
      padding: 56px 0 28px;
    }
    h1 {
      font-size: 28px;
    }
    .project {
      padding: 20px;
    }
    .demo-note {
      padding: 18px 20px;
    }
  }
</style>
