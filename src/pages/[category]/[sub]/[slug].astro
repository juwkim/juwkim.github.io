---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/prose.css';
import katexCss from 'katex/dist/katex.min.css?url';
import {
  getPosts,
  postUrl,
  postSlug,
  findCategory,
  findSub,
  categoryUrl,
  subUrl,
  longDate,
  readingMinutes,
  type Post,
} from '../../../lib/posts';

// /<카테고리>/<세부>/<글>/ — 이전/다음 글은 같은 세부 카테고리 안에서 이어짐 (시리즈 순서대로 읽기 좋게)
export async function getStaticPaths() {
  const posts = await getPosts(); // 최신순
  return posts.map((post) => {
    const cat = findCategory(post.data.category);
    const sub = findSub(cat, post.data.subcategory);
    const siblings = posts.filter((p) => p.data.subcategory === post.data.subcategory && p.data.category === post.data.category);
    const i = siblings.indexOf(post);
    return {
      params: { category: cat.slug, sub: sub.slug, slug: postSlug(post) },
      props: { post, newer: siblings[i - 1], older: siblings[i + 1] },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, category, subcategory, description, tags } = post.data;
const cat = findCategory(category);
const sub = findSub(cat, subcategory);
// 수식이 있는 글에서만 KaTeX 스타일을 불러옴
const hasMath = /\$\$|\$[^\s$][^$\n]*\$/.test((post.body ?? '').replace(/```[\s\S]*?```/g, ''));
---

<Base title={title} description={description} type="article">
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  {hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <div class="wrap">
    <header class="article-head">
      <nav class="crumb" aria-label="카테고리 경로">
        <a href={categoryUrl(cat)}>{category}</a>
        <span aria-hidden="true">›</span>
        <a href={subUrl(cat, sub)}>{subcategory}</a>
      </nav>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{longDate(date)}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{readingMinutes(post.body)}분 읽기</span>
      </div>
    </header>

    <article class="prose" data-pagefind-body>
      <Content />
    </article>

    {
      tags.length > 0 && (
        <ul class="tags" aria-label="태그">
          {tags.map((t) => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }

    <nav class="pager" aria-label="이전/다음 글">
      {
        older && (
          <a href={postUrl(older)}>
            <small>{sub.name}의 이전 글</small>
            <span>{older.data.title}</span>
          </a>
        )
      }
      {
        newer && (
          <a href={postUrl(newer)} class="next">
            <small>{sub.name}의 다음 글</small>
            <span>{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </div>
</Base>

<style>
  .article-head {
    padding: 72px 0 36px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .crumb {
    display: flex;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-3);
    margin-bottom: 14px;
  }
  .crumb a {
    color: var(--blue);
  }
  .crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1 {
    font-size: 34px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    word-break: keep-all;
  }
  .meta {
    font-size: 14px;
    color: var(--fg-3);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--fg-3);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 40px 0 0;
  }
  .tags li {
    font-size: 13px;
    color: var(--fg-2);
    background: var(--bg-subtle);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 56px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .pager a:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow);
  }
  .pager small {
    display: block;
    font-size: 12px;
    color: var(--fg-3);
    margin-bottom: 4px;
  }
  .pager span {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    word-break: keep-all;
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 27px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
    }
  }
</style>
