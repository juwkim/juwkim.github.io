---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import PostImageViewer from '../../../components/PostImageViewer.astro';
import Comments from '../../../components/Comments.astro';
import '../../../styles/prose.css';
import katexCss from 'katex/dist/katex.min.css?url';
import {
  getPosts,
  postUrl,
  postSlug,
  findCategory,
  findSub,
  categoryUrl,
  subUrl,
  longDate,
  readingMinutes,
  type Post,
} from '../../../lib/posts';

// /<카테고리>/<세부>/<글>/ — 이전/다음 글은 같은 세부 카테고리 안에서 이어짐 (시리즈 순서대로 읽기 좋게)
export async function getStaticPaths() {
  const posts = await getPosts(); // 최신순
  return posts.map((post) => {
    const cat = findCategory(post.data.category);
    const sub = findSub(cat, post.data.subcategory);
    const siblings = posts.filter((p) => p.data.subcategory === post.data.subcategory && p.data.category === post.data.category);
    const i = siblings.indexOf(post);
    return {
      params: { category: cat.slug, sub: sub.slug, slug: postSlug(post) },
      props: { post, newer: siblings[i - 1], older: siblings[i + 1] },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const allPosts = await getPosts(); // 왼쪽 카테고리 글 수 계산용
const { Content, headings } = await render(post);
// 오른쪽 목차: 소제목(h2, h3)이 2개 이상일 때만
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 2;
const { title, date, category, subcategory, description, tags } = post.data;
const cat = findCategory(category);
const sub = findSub(cat, subcategory);
// 수식이 있는 글에서만 KaTeX 스타일을 불러옴
const hasMath = /\$\$|\$[^\s$][^$\n]*\$/.test((post.body ?? '').replace(/```[\s\S]*?```/g, ''));
---

<Base title={title} description={description} type="article">
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  {hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <div class="post-layout">
  <aside class="side">
    <CategoryNav mode="sidebar" posts={allPosts} current={{ cat: cat.slug, sub: sub.slug }} />
  </aside>
  <div class="col">
    <header class="article-head">
      <nav class="crumb" aria-label="카테고리 경로">
        <a href={categoryUrl(cat)}>{category}</a>
        <span aria-hidden="true">›</span>
        <a href={subUrl(cat, sub)}>{subcategory}</a>
      </nav>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{longDate(date)}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{readingMinutes(post.body)}분 읽기</span>
      </div>
    </header>

    <article id="post-body" class="prose" data-pagefind-body>
      <Content />
    </article>
    <PostImageViewer for="post-body" />

    {
      tags.length > 0 && (
        <ul class="tags" aria-label="태그">
          {tags.map((t) => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }

    <Comments />

    <nav class="pager" aria-label="이전/다음 글">
      {
        older && (
          <a href={postUrl(older)}>
            <small>{sub.name}의 이전 글</small>
            <span>{older.data.title}</span>
          </a>
        )
      }
      {
        newer && (
          <a href={postUrl(newer)} class="next">
            <small>{sub.name}의 다음 글</small>
            <span>{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </div>
  {
    showToc && (
      <aside class="toc" aria-label="목차">
        <p>목차</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
  </div>
</Base>

<script>
  // 목차: 지금 읽는 소제목을 파란색으로 표시
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length) {
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);
    const setActive = () => {
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t;
      links.forEach((a) => a.classList.toggle('on', decodeURIComponent(a.hash.slice(1)) === current?.id));
    };
    addEventListener('scroll', setActive, { passive: true });
    setActive();
  }
</script>

<style>
  /* 레이아웃
     좁은 화면: 본문 한 칸
     1080px 이상: 왼쪽 카테고리 | 본문
     1280px 이상: 왼쪽 카테고리 | 본문 | 오른쪽 목차 */
  .post-layout {
    max-width: calc(var(--width) + 48px);
    margin: 0 auto;
    padding: 0 24px;
  }
  .side,
  .toc {
    display: none;
  }
  .col {
    min-width: 0;
  }
  @media (min-width: 1080px) {
    .post-layout {
      max-width: var(--page);
      padding: 0 32px;
      display: grid;
      grid-template-columns: 200px minmax(0, var(--width));
      column-gap: 64px;
    }
    .side {
      display: block;
      padding-top: 72px;
    }
    .side :global(.sidebar) {
      top: 84px;
    }
  }
  @media (min-width: 1280px) {
    .post-layout {
      grid-template-columns: 200px minmax(0, var(--width)) 160px;
      column-gap: 48px;
    }
    .toc {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
      max-height: calc(100dvh - 128px);
      overflow-y: auto;
      margin-top: 240px;
      scrollbar-width: none;
    }
    .toc::-webkit-scrollbar {
      display: none;
    }
  }
  .toc p {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--fg-3);
    margin: 0 0 10px;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--fg-3);
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    word-break: keep-all;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .toc .d3 a {
    padding-left: 26px;
    font-size: 12.5px;
  }
  .toc a:hover {
    color: var(--fg);
  }
  .toc a.on {
    color: var(--blue);
    border-left-color: var(--blue);
  }
  .article-head {
    padding: 72px 0 36px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .crumb {
    display: flex;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-3);
    margin-bottom: 14px;
  }
  .crumb a {
    color: var(--blue);
  }
  .crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1 {
    font-size: 34px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    word-break: keep-all;
  }
  .meta {
    font-size: 14px;
    color: var(--fg-3);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--fg-3);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 40px 0 0;
  }
  .tags li {
    font-size: 13px;
    color: var(--fg-2);
    background: var(--bg-subtle);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 56px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .pager a:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow);
  }
  .pager small {
    display: block;
    font-size: 12px;
    color: var(--fg-3);
    margin-bottom: 4px;
  }
  .pager span {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    word-break: keep-all;
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 27px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
    }
  }
</style>
