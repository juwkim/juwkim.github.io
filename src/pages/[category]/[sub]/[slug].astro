---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import PostImageViewer from '../../../components/PostImageViewer.astro';
import PostCodeBlocks from '../../../components/PostCodeBlocks.astro';
import PostHeadingLinks from '../../../components/PostHeadingLinks.astro';
import Comments from '../../../components/Comments.astro';
import '../../../styles/prose.css';
import katexCss from 'katex/dist/katex.min.css?url';
import {
  getPosts,
  postUrl,
  postSlug,
  findCategory,
  findSub,
  categoryUrl,
  subUrl,
  longDate,
  readingMinutes,
  type Post,
} from '../../../lib/posts';

// /<카테고리>/<세부>/<글>/: 이전/다음 글은 같은 세부 카테고리 안에서 이어짐 (시리즈 순서대로 읽기 좋게)
export async function getStaticPaths() {
  const posts = await getPosts(); // 최신순
  return posts.map((post) => {
    const cat = findCategory(post.data.category);
    const sub = findSub(cat, post.data.subcategory);
    const siblings = posts.filter((p) => p.data.subcategory === post.data.subcategory && p.data.category === post.data.category);
    const i = siblings.indexOf(post);
    return {
      params: { category: cat.slug, sub: sub.slug, slug: postSlug(post) },
      props: { post, newer: siblings[i - 1], older: siblings[i + 1] },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const allPosts = await getPosts(); // 왼쪽 카테고리 글 수 계산용
const { Content, headings } = await render(post);
// 오른쪽 목차: 소제목(h2, h3)이 2개 이상일 때만
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 2;
const { title, date, category, subcategory, description, tags } = post.data;
const cat = findCategory(category);
const sub = findSub(cat, subcategory);
// 수식이 있는 글에서만 KaTeX 스타일을 불러옴
const hasMath = /\$\$|\$[^\s$][^$\n]*\$/.test((post.body ?? '').replace(/```[\s\S]*?```/g, ''));
---

<Base title={title} description={description} type="article">
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  {hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <div class="post-layout">
  <aside class="side">
    <CategoryNav mode="sidebar" posts={allPosts} current={{ cat: cat.slug, sub: sub.slug }} />
  </aside>
  <div class="col">
    <header class="article-head">
      <nav class="crumb" aria-label="카테고리 경로">
        <a href={categoryUrl(cat)}>{category}</a>
        <span aria-hidden="true">›</span>
        <a href={subUrl(cat, sub)}>{subcategory}</a>
      </nav>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{longDate(date)}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{readingMinutes(post.body)}분 읽기</span>
      </div>
    </header>

    {
      showToc && (
        <nav class="toc-mobile-wrap" aria-label="이 글의 목차">
          <details class="toc-mobile">
            <summary>
              <span class="toc-mobile-title">
                <span>목차</span>
                <span class="toc-mobile-count">{toc.length}</span>
              </span>
              <svg class="toc-mobile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      )
    }

    <article id="post-body" class="prose" data-pagefind-body>
      <Content />
    </article>
    <PostImageViewer for="post-body" />
    <PostCodeBlocks for="post-body" />
    <PostHeadingLinks for="post-body" />

    {
      tags.length > 0 && (
        <ul class="tags" aria-label="태그">
          {tags.map((t) => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }

    <Comments />

    <nav class="pager" aria-label="이전/다음 글">
      {
        older && (
          <a href={postUrl(older)}>
            <small>{sub.name}의 이전 글</small>
            <span>{older.data.title}</span>
          </a>
        )
      }
      {
        newer && (
          <a href={postUrl(newer)} class="next">
            <small>{sub.name}의 다음 글</small>
            <span>{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </div>
  {
    showToc && (
      <aside class="toc" aria-label="목차">
        <p>목차</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
  </div>
</Base>

<script>
  // 목차(데스크톱·모바일 공통): 지금 읽는 소제목을 파란색으로 표시 + 모바일 목차 클릭 시 자동 접기
  const idOf = (a: HTMLAnchorElement) => {
    const href = a.getAttribute('href');
    if (href?.startsWith('#')) return href.slice(1);
    const raw = a.hash.slice(1);
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  };

  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a, .toc-mobile a')];
  if (links.length) {
    const seen = new Set<string>();
    const targets: HTMLElement[] = [];
    for (const a of links) {
      const id = idOf(a);
      if (!id || seen.has(id)) continue;
      seen.add(id);
      const el = document.getElementById(id);
      if (el) targets.push(el);
    }

    const setActive = () => {
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t;
      for (const a of links) {
        const active = !!current && idOf(a) === current.id;
        a.classList.toggle('on', active);
        if (active) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', setActive, { passive: true });
    setActive();

    const mobileToc = document.querySelector<HTMLDetailsElement>('.toc-mobile');
    mobileToc?.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      const anchor = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (!anchor) return;
      const id = idOf(anchor);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;

      e.preventDefault();
      mobileToc.open = false;
      requestAnimationFrame(() => {
        history.pushState(null, '', `#${encodeURIComponent(id)}`);
        target.scrollIntoView();
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        setActive();
      });
    });
  }
</script>

<style>
  /* 레이아웃
     좁은 화면: 본문 한 칸
     1080px 이상: 왼쪽 카테고리 | 본문
     1280px 이상: 왼쪽 카테고리 | 본문 | 오른쪽 목차 */
  .post-layout {
    max-width: calc(var(--width) + 48px);
    margin: 0 auto;
    padding: 0 24px;
  }
  .side,
  .toc {
    display: none;
  }
  .col {
    min-width: 0;
  }
  @media (min-width: 1080px) {
    .post-layout {
      max-width: none;
      margin: 0;
      padding: 0 var(--edge);
      display: grid;
      grid-template-columns: var(--sidebar) minmax(0, 1fr);
      column-gap: 56px;
    }
    .side {
      display: block;
    }
    /* 본문은 가운데 열 안에서 읽기 좋은 폭(--width)으로 가운데 정렬 */
    .col {
      max-width: var(--width);
      width: 100%;
      margin: 0 auto;
    }
  }
  @media (min-width: 1280px) {
    .post-layout {
      grid-template-columns: var(--sidebar) minmax(0, 1fr) 220px;
      column-gap: 48px;
    }
    .toc-mobile-wrap {
      display: none;
    }
    .toc {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
      max-height: calc(100dvh - 128px);
      overflow-y: auto;
      overscroll-behavior: contain;
      margin-top: 240px;
      scrollbar-width: none;
    }
    .toc::-webkit-scrollbar {
      display: none;
    }
  }
  .toc-mobile-wrap {
    margin: 0 0 32px;
  }
  .toc-mobile {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-subtle);
    overflow: hidden;
  }
  .toc-mobile summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 10px 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--fg-2);
    cursor: pointer;
    user-select: none;
  }
  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile summary:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -2px;
    border-radius: 14px;
  }
  .toc-mobile-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .toc-mobile-count {
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .toc-mobile-chevron {
    flex: none;
    color: var(--fg-3);
    transition: transform 0.2s var(--ease);
  }
  .toc-mobile[open] .toc-mobile-chevron {
    transform: rotate(180deg);
  }
  .toc-mobile ul {
    list-style: none;
    margin: 0;
    padding: 8px 12px 12px;
    border-top: 1px solid var(--line);
  }
  .toc-mobile a {
    display: block;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--fg-2);
    word-break: keep-all;
    transition: background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .toc-mobile .d3 a {
    padding-left: 24px;
    font-size: 13px;
    color: var(--fg-3);
  }
  .toc-mobile a:hover {
    color: var(--fg);
    background: rgba(0, 0, 0, 0.04);
  }
  :global(:root[data-theme='dark']) .toc-mobile a:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .toc-mobile a.on {
    color: var(--blue);
    background: var(--blue-soft);
    font-weight: 500;
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-mobile-chevron,
    .toc-mobile a {
      transition-duration: 0.01ms !important;
    }
  }
  @media print {
    .toc,
    .toc-mobile-wrap {
      display: none;
    }
  }
  .toc p {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--fg-3);
    margin: 0 0 10px;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--fg-3);
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    word-break: keep-all;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .toc .d3 a {
    padding-left: 26px;
    font-size: 12.5px;
  }
  .toc a:hover {
    color: var(--fg);
  }
  .toc a.on {
    color: var(--blue);
    border-left-color: var(--blue);
  }
  .article-head {
    padding: 72px 0 36px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .crumb {
    display: flex;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-3);
    margin-bottom: 14px;
  }
  .crumb a {
    color: var(--blue);
  }
  .crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1 {
    font-size: 34px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    word-break: keep-all;
  }
  .meta {
    font-size: 14px;
    color: var(--fg-3);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--fg-3);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 40px 0 0;
  }
  .tags li {
    font-size: 13px;
    color: var(--fg-2);
    background: var(--bg-subtle);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 56px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .pager a:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow);
  }
  .pager small {
    display: block;
    font-size: 12px;
    color: var(--fg-3);
    margin-bottom: 4px;
  }
  .pager span {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    word-break: keep-all;
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 27px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
    }
  }
</style>
